# Disposable Linux evaluator image.  Keep both the base image digest and the
# Codex package version pinned so an evaluation can be reproduced later.
FROM node:22.14.0-bookworm-slim@sha256:1c18d9ab3af4585870b92e4dbc5cac5a0dc77dd13df1a5905cea89fc720eb05b

ARG CODEX_VERSION=0.147.0

USER root
RUN apt-get update \
    && apt-get install --yes --no-install-recommends ca-certificates git python3 \
    && rm -rf /var/lib/apt/lists/*

# This is the official @openai/codex npm package and its platform-specific
# optional dependency.  The checks make accidental replacement with a host
# binary or a look-alike script fail the image build.
RUN npm install --global --omit=dev "@openai/codex@${CODEX_VERSION}" \
    && test -x "$(command -v codex)" \
    && CODEX_VERSION="${CODEX_VERSION}" node -e "const p=require('/usr/local/lib/node_modules/@openai/codex/package.json'); if (p.name !== '@openai/codex' || p.version !== process.env.CODEX_VERSION) process.exit(1)" \
    && codex --version

RUN useradd --create-home --uid 10001 --shell /usr/sbin/nologin evaluator

ENV HOME=/tmp/home \
    CODEX_HOME=/tmp/codex-home \
    PATH=/usr/local/bin:/usr/bin:/bin
WORKDIR /work
USER evaluator
ENTRYPOINT ["/bin/sh"]
