<idea-plugin>
    <id>__PLUGIN_ID__</id>
    <name>__PLUGIN_NAME__</name>
    <vendor>__VENDOR_NAME__</vendor>

    <depends>com.intellij.modules.platform</depends>
    <resource-bundle>messages.PluginBundle</resource-bundle>

    <extensions defaultExtensionNs="com.intellij" />

    <actions>
        <action
            id="__PLUGIN_ID__.ExampleAction"
            class="__PACKAGE__.ExampleAction"
            text="Example Action"
            description="Runs the example action">
            <add-to-group group-id="ToolsMenu" anchor="last" />
        </action>
    </actions>
</idea-plugin>
